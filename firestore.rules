rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isTripOwner(tripData) {
      return request.auth.uid == tripData.userId;
    }

    function hasTripAccess(tripData) {
      return isTripOwner(tripData) || request.auth.uid in tripData.shared;
    }

    // Subcollection rules use get() on the parent trip; require exists to avoid
    // evaluating hasTripAccess on a missing parent document.
    function canAccessParentTrip(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId)) &&
        hasTripAccess(get(/databases/$(database)/documents/trips/$(tripId)).data);
    }

    // Users — any authenticated user can read (needed for email lookup),
    // but only the account owner can write their own document.
    match /users/{userId} {
      allow read:  if isAuthed();
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    // Username reservations.
    // Stored as: usernames/{username} -> { uid: <owner uid> }.
    // Used to enforce uniqueness with a Firestore transaction.
    match /usernames/{username} {
      allow read: if isAuthed();
      allow create: if isAuthed() &&
        request.resource.data.uid == request.auth.uid &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow delete: if isAuthed() &&
        resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /trips/{tripId} {
      // Owner or anyone in shared[] can read.
      allow read: if isAuthed() && hasTripAccess(resource.data);

      // Authenticated user can create a trip they own.
      allow create: if isAuthed() && request.auth.uid == request.resource.data.userId;

      // Owner can update any field.
      // Manager: full trip control except transferring ownership.
      // Any member: can add new members (shared[] may only grow) and update
      //   permissions for newly added UIDs; cannot shrink shared[] or change userId.
      // Self-removal: a member can remove only themselves (shared shrinks by exactly 1).
      // Self-enrollment: a non-member can add only themselves via invite acceptance.
      allow update: if isAuthed() && (
        // 1. Owner — unrestricted.
        isTripOwner(resource.data)
        ||
        // 2. Manager — can do anything except change the owner (userId).
        (
          request.auth.uid in resource.data.shared &&
          resource.data.permissions[request.auth.uid] == 'manager' &&
          request.resource.data.userId == resource.data.userId
        )
        ||
        // 3. Any member — can invite new people (shared[] grows or stays same)
        //    and update the permissions map. Cannot remove members or change owner.
        (
          request.auth.uid in resource.data.shared &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.shared.hasAll(resource.data.shared)
        )
        ||
        // 4. Self-removal — member removes only themselves (size drops by exactly 1).
        (
          request.auth.uid in resource.data.shared &&
          !(request.auth.uid in request.resource.data.shared) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.shared.size() == resource.data.shared.size() - 1
        )
        ||
        // 5. Self-enrollment — new user accepts a pending invite.
        (
          !(request.auth.uid in resource.data.shared) &&
          request.auth.uid in request.resource.data.shared &&
          request.resource.data.userId == resource.data.userId
        )
      );

      // Only the owner can delete a trip.
      allow delete: if isAuthed() && isTripOwner(resource.data);

      // Days subcollection — owner or shared users.
      match /days/{dayId} {
        allow read, write: if isAuthed() && canAccessParentTrip(tripId);
      }

      // Events nested under days — owner or shared users.
      match /days/{dayId}/events/{eventId} {
        allow read, write: if isAuthed() && canAccessParentTrip(tripId);
      }

      // AI suggestions cache (singleton doc at /meta/aiSuggestions).
      // Any trip member can read; any member can write (generate/refresh suggestions).
      match /meta/{metaId} {
        allow read, write: if isAuthed() && canAccessParentTrip(tripId);
      }

      // Misc page — collaborative notes (singleton doc at /notes/current).
      // Any trip member can read/write; the soft-edit lock is enforced at
      // the app layer via transactions.
      match /notes/{noteId} {
        allow read, write: if isAuthed() && canAccessParentTrip(tripId);
      }

      // Misc page — tic-tac-toe game state (singleton doc at /game/current).
      // Any trip member can read; any member can create an invite or act on
      // their own game. Move validation is enforced app-side via transactions.
      match /game/{gameId} {
        allow read, write: if isAuthed() && canAccessParentTrip(tripId);
      }

      // Misc page — trip photos. Any member can upload (create) and read.
      // Update is disabled (photos are immutable). Delete is restricted to
      // the uploader.
      match /photos/{photoId} {
        allow read: if isAuthed() && canAccessParentTrip(tripId);
        allow create: if isAuthed() && canAccessParentTrip(tripId) &&
          request.resource.data.uploaderUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAuthed() && canAccessParentTrip(tripId) &&
          resource.data.uploaderUid == request.auth.uid;
      }
    }

    // Wildcard rule required for collectionGroup("events") queries.
    match /{path=**}/events/{eventId} {
      allow read, write: if isAuthed();
    }

    // Session selections — scoped to a trip's members.
    // Any trip member can read all selections for that trip.
    // A user can write their own selection document; the trip owner can delete any.
    match /sessions/{tripId}/selections/{userId} {
      allow read: if isAuthed() && canAccessParentTrip(tripId);
      allow write: if isAuthed() &&
        canAccessParentTrip(tripId) &&
        (request.auth.uid == userId ||
         isTripOwner(get(/databases/$(database)/documents/trips/$(tripId)).data));
    }

    // Event edit locks — prevent concurrent edits across users.
    // Any trip member can read locks (to see who holds them).
    // Only owners and managers (roles with edit_event permission) can
    // acquire/release, and the lock's uid must match the caller.
    // Delete is permitted for callers holding the lock OR overwriting an
    // expired lock (transaction validates expiry client-side).
    match /sessions/{tripId}/eventLocks/{eventId} {
      function tripData() {
        return get(/databases/$(database)/documents/trips/$(tripId)).data;
      }
      function canEditEvents() {
        return isTripOwner(tripData()) ||
          tripData().permissions[request.auth.uid] == 'manager';
      }
      allow read: if isAuthed() && canAccessParentTrip(tripId);
      allow create, update: if isAuthed() &&
        canAccessParentTrip(tripId) &&
        canEditEvents() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthed() && canAccessParentTrip(tripId) && canEditEvents();
    }

    // Pending invites for users who haven't signed up yet.
    // Authenticated users can read invites (needed for signup acceptance flow).
    // Only Cloud Functions (admin SDK) create/update invites.
    // The user who sent the invite can delete (cancel) it.
    match /invites/{inviteId} {
      allow read: if isAuthed();
      allow create: if false; // only via Cloud Functions
      // A user can accept an invite: status must go pending → accepted
      // and acceptedBy must be set to the caller's own UID.
      allow update: if isAuthed() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.acceptedBy == request.auth.uid;
      allow delete: if isAuthed() && (
        request.auth.uid == resource.data.invitedBy ||
        get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.permissions[request.auth.uid] == 'manager'
      );
    }

    // Geoapify suggestion cache, keyed by rounded lat/lng.
    // Any authed user can read; only the Cloud Function (admin SDK) writes.
    match /placeSuggestionsCache/{locationKey} {
      allow read: if isAuthed();
      allow write: if false;
    }
  }
}
