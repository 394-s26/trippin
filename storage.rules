rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /tripBanners/{tripId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        firestore.get(/databases/(default)/documents/trips/$(tripId)).data.userId == request.auth.uid
        ||
        (
          request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.shared &&
          firestore.get(/databases/(default)/documents/trips/$(tripId)).data.permissions[request.auth.uid] == 'manager'
        )
      );
    }

    // Trip photos — uploaded from the Misc page. Any trip member can read or
    // upload; only the uploader can delete (path includes uploader uid).
    match /tripPhotos/{tripId}/{uploaderUid}/{filename} {
      allow read: if request.auth != null && (
        firestore.get(/databases/(default)/documents/trips/$(tripId)).data.userId == request.auth.uid
        ||
        request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.shared
      );
      allow create: if request.auth != null &&
        request.auth.uid == uploaderUid &&
        (
          firestore.get(/databases/(default)/documents/trips/$(tripId)).data.userId == request.auth.uid
          ||
          request.auth.uid in firestore.get(/databases/(default)/documents/trips/$(tripId)).data.shared
        );
      allow delete: if request.auth != null && request.auth.uid == uploaderUid;
      allow update: if false;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
